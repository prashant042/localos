# Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/localos_db?schema=public"

# Application Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & JWT Secrets
JWT_SECRET="your_jwt_secret_key_minimum_32_chars_long"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_minimum_32_chars_long"
COOKIE_DOMAIN="localhost"

# Razorpay (Indian Payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Storage
STORAGE_PROVIDER="local"
STORAGE_BUCKET="localos-attachments"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Email Notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@localos.in"
SMTP_PASS="password"
FROM_EMAIL="LocalOS <notifications@localos.in>"

